{
  "name": "mushrifi-license-api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "check": "tsc --noEmit",
    "deploy": "wrangler deploy",
    "db:local": "wrangler d1 execute mushrifi-licenses --local --file=./schema.sql",
    "db:remote": "wrangler d1 execute mushrifi-licenses --remote --file=./schema.sql",
    "test:rate-limit": "node scripts/rate-limit-config-test.mjs",
    "test:rate-limit-behavior": "node scripts/rate-limit-behavior-test.mjs",
    "test:device-identity-binding": "node scripts/device-identity-binding-test.mjs",
    "test:rate-limit-staging": "node scripts/rate-limit-staging-smoke.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261114.1",
    "typescript": "^5.9.3",
    "wrangler": "^4.45.0"
  }
}
